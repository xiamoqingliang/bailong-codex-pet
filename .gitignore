*.dll
*.pyd
*.webp
*.png
*.mp3
*.wav
runtime/
_internal/
outputs/
releases/
codex-integration/clean-assets/

# 本地运行与开发数据。
__pycache__/
*.pyc
*.tmp
*.log
*.stop
.venv/
codex-integration/bridge/*-status.json
codex-integration/bridge/*-state.json
codex-integration/bridge/*-request.json
