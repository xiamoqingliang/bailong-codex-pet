# 账号与聊天内容。
.env
.env.*
auth.json
config.toml
conversations.json
*.sqlite
*.sqlite-*

# 本机安装归属与卸载状态。
uninstall.request
install-status.txt
install-diagnostic.json
codex-integration/bridge/launch-error.json
codex-integration/bridge/.identity-probe.*.json
pet-install-receipts/

# 去噪工具本地产生的预览、素材与路径报告。
tools/alpha-cleanup/clean-assets/
tools/alpha-cleanup/idle2-trial/

# 本机开发输出。
*.webm
analysis/
publish/


